// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FinalRemark {
  INTERVIEW_PENDING
  REJECTED
  FINAL_SELECTION
  CLIENT_SELECTED
  BACK_OUT
  ON_HOLD
  OTHER
}

model Country {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  states    State[]
  createdAt DateTime @default(now())
}

model State {
  id        String  @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, name])
  @@index([countryId])
}

model City {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  isCustom  Boolean  @default(false)
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([stateId, name])
  @@index([stateId])
}

model Store {
  id               String         @id @default(cuid())
  externalStoreId  String?        @unique
  accountName      String
  storeName        String
  country          String         @default("India")
  city             String
  state            String
  address          String
  supervisor       String?
  poa              String?
  region           String?
  vertical         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  openPositions    OpenPosition[]
  lineups          Lineup[]

  @@index([storeName, city, state])
  @@index([accountName, storeName])
  @@index([state, city])
}

model OpenPosition {
  id                String    @id @default(cuid())
  storeId           String
  designation       String
  positionCount     Int
  openPositionCount Int
  dateOfOpen        DateTime?
  selectionDate     DateTime?
  sourceFileName    String?
  sourceRowNumber   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([designation])
  @@index([createdAt])
  @@index([dateOfOpen])
}

model Candidate {
  id                    String    @id @default(cuid())
  name                  String
  contactNumber         String?
  recruiter             String?
  qualification         String?
  currentOrganization   String?
  experienceYears       Float?
  currentSalary         Float?
  expectedSalary        Float?
  city                  String?
  state                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lineups               Lineup[]

  @@index([name])
  @@index([contactNumber])
}

model Lineup {
  id                String      @id @default(cuid())
  storeId           String
  candidateId       String
  lineupDate        DateTime?
  clientRemarks     String?
  finalRemarks      String?
  finalRemarkTag    FinalRemark @default(OTHER)
  feedbackDate      DateTime?
  tatForFeedback    Int?
  remarks           String?
  sourceFileName    String?
  sourceRowNumber   Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  store             Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  candidate         Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([candidateId])
  @@index([finalRemarkTag])
  @@index([createdAt])
}

model ImportJob {
  id                 String      @id @default(cuid())
  sourceFileName     String
  sourceStoragePath  String?
  status             String
  startedAt          DateTime    @default(now())
  completedAt        DateTime?
  rowsRead           Int         @default(0)
  rowsImported       Int         @default(0)
  errorsCount        Int         @default(0)
  errorsJson         String?
}

model Dashboard {
  id              String            @id @default(cuid())
  name            String
  isDefault       Boolean           @default(false)
  filtersJson     String
  layoutJson      String
  widgets         DashboardWidget[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DashboardWidget {
  id            String     @id @default(cuid())
  dashboardId   String
  title         String
  widgetType    String
  configJson    String
  orderIndex    Int
  dashboard     Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, orderIndex])
}

// --- Task tracking module (isolated from hiring) ---

enum OpsRole {
  ADMIN
  MEMBER
}

enum OpsTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OpsTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpsFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model OpsUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  designation  String?
  passwordHash String
  role         OpsRole  @default(MEMBER)
  isActive     Boolean  @default(true)
  canCreateTask Boolean @default(true)
  canAssignTask Boolean @default(true)
  canViewAllTasks Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks OpsTask[]         @relation("OpsTaskAssignee")
  createdTasks  OpsTask[]         @relation("OpsTaskCreator")
  taggedOn      OpsTaskMember[]
  grantedTaskAccess OpsTaskMember[] @relation("OpsTaskAccessGrantedBy")
  notes         OpsTaskNote[]
  activities    OpsTaskActivity[]
  etaAlertsRead OpsTaskEtaAlert[] @relation("OpsEtaAlertAcknowledgedBy")

  @@index([role, isActive])
}

model OpsTask {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      OpsTaskStatus   @default(TODO)
  priority    OpsTaskPriority @default(MEDIUM)
  dueAt       DateTime?
  etaBreachedAt DateTime?
  assigneeId  String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  assignee   OpsUser?            @relation("OpsTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  OpsUser             @relation("OpsTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members    OpsTaskMember[]
  fieldValues OpsTaskFieldValue[]
  notes      OpsTaskNote[]
  activities OpsTaskActivity[]
  etaAlerts  OpsTaskEtaAlert[]

  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
  @@index([etaBreachedAt])
  @@index([createdAt])
}

model OpsTaskEtaAlert {
  id               String   @id @default(cuid())
  taskId            String   @unique
  breachedAt        DateTime
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  createdAt         DateTime @default(now())

  task           OpsTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  acknowledgedBy OpsUser? @relation("OpsEtaAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([acknowledgedAt])
  @@index([breachedAt])
}

model OpsTaskMember {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  grantedById String?
  createdAt DateTime @default(now())

  task OpsTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user OpsUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy OpsUser? @relation("OpsTaskAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([grantedById])
}

model OpsTaskFieldDefinition {
  id          String       @id @default(cuid())
  label       String
  slug        String       @unique
  fieldType   OpsFieldType @default(TEXT)
  optionsJson String?
  orderIndex  Int          @default(0)
  isRequired  Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  values OpsTaskFieldValue[]

  @@index([isActive, orderIndex])
}

model OpsTaskFieldValue {
  id                String @id @default(cuid())
  taskId            String
  fieldDefinitionId String
  value             String @default("")

  task            OpsTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldDefinition OpsTaskFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([taskId, fieldDefinitionId])
  @@index([fieldDefinitionId])
}

model OpsTaskNote {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   OpsTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author OpsUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model OpsTaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  message   String
  createdAt DateTime @default(now())

  task   OpsTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author OpsUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}
